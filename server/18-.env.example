# Server-side only. Set these as environment variables on the host. Never commit a real .env.
PORT=8080
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-NEW-CLUSTER.mongodb.net/tutor?retryWrites=true&w=majority
JWT_SECRET=long_random_string
GROQ_API_KEY=your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile
ALLOWED_ORIGIN=https://YOUR-APP.web.app
